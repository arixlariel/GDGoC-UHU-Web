{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/ig", "destination": "https://www.instagram.com/gdgoc.huelva/", "permanent": false },
    { "source": "/instagram", "destination": "https://www.instagram.com/gdgoc.huelva/", "permanent": false },
    { "source": "/linkedin", "destination": "https://www.linkedin.com/company/gdgoc-huelva", "permanent": false },
    { "source": "/in", "destination": "https://www.linkedin.com/company/gdgoc-huelva", "permanent": false },
    { "source": "/comunidad", "destination": "https://gdg.community.dev/gdg-on-campus-huelva-university-huelva-spain/", "permanent": false },
    { "source": "/bevy", "destination": "https://gdg.community.dev/gdg-on-campus-huelva-university-huelva-spain/", "permanent": false },
    { "source": "/ctf", "destination": "/cybertrainer/", "permanent": false },
    { "source": "/ctfs", "destination": "/cybertrainer/", "permanent": false },
    { "source": "/ctfd", "destination": "/cybertrainer/", "permanent": false },
    { "source": "/badges", "destination": "/openbadges/", "permanent": false },
    { "source": "/certificados", "destination": "/openbadges/", "permanent": false },
    { "source": "/openbadges", "destination": "/openbadges/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/openbadges/", "destination": "https://gdgoc-uhu-openbadges.vercel.app/openbadges/" },
    { "source": "/openbadges/:path*/", "destination": "https://gdgoc-uhu-openbadges.vercel.app/openbadges/:path*/" },
    { "source": "/openbadges/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/openbadges/:path*" },
    { "source": "/cert/:path*/", "destination": "https://gdgoc-uhu-openbadges.vercel.app/cert/:path*/" },
    { "source": "/cert/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/cert/:path*" },
    { "source": "/api/badges/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/api/badges/:path*" },
    { "source": "/.well-known/did.json", "destination": "https://gdgoc-uhu-openbadges.vercel.app/.well-known/did.json" },
    { "source": "/og/openbadges.png", "destination": "https://gdgoc-uhu-openbadges.vercel.app/og/openbadges.png" },
    { "source": "/og/cert/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/og/cert/:path*" },
    { "source": "/vendor/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/vendor/:path*" },
    { "source": "/images/badges/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/images/badges/:path*" },
    { "source": "/_astro-ob/:path*", "destination": "https://gdgoc-uhu-openbadges.vercel.app/_astro-ob/:path*" },
    { "source": "/generador-local.html", "destination": "https://gdgoc-uhu-openbadges.vercel.app/generador-local.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
