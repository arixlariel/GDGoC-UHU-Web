---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MaintenanceCard from '@/components/MaintenanceCard.astro';

type ThemeKey = 'google' | 'cyber' | 'piscina' | 'nieve' | 'caramelos';
const VALID_THEMES = new Set<ThemeKey>(['google', 'cyber', 'piscina', 'nieve', 'caramelos']);
const OPENBADGES_ORIGIN = process.env.OPENBADGES_ORIGIN || 'https://gdgoc-uhu-openbadges.vercel.app';

const certStyleMap: Record<string, ThemeKey> = {};
try {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 5000);
  const res = await fetch(`${OPENBADGES_ORIGIN}/api/badges/styles.json`, {
    headers: { Accept: 'application/json' },
    signal: controller.signal,
  });
  clearTimeout(timer);
  if (res.ok) {
    const raw = await res.json();
    if (raw && typeof raw === 'object') {
      for (const [id, style] of Object.entries(raw)) {
        if (typeof style === 'string' && VALID_THEMES.has(style as ThemeKey)) {
          certStyleMap[id] = style as ThemeKey;
        }
      }
    }
  }
} catch {
  // Respaldo seguro: si la consulta falla en build, se aplicará el tema guardado del usuario
}
---

<BaseLayout
  title="Mantenimiento · GDGoC UHU Open Badges"
  description="Estamos realizando tareas de mantenimiento en GDGoC UHU Open Badges. Tus certificados volverán a estar disponibles en breve."
  section="openbadges"
  certStyleMap={certStyleMap}
  noIndex={true}
>
  <MaintenanceCard scope="openbadges" />
</BaseLayout>
